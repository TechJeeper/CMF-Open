    {
      "id": "daylight",
      "name": "Daylight",
      "version": "1.0.0",
      "author": "cmfkit",
      "description": "Today's real sun path where you live: sunrise, sunset and hours of daylight, worked out on your device.",
      "tags": [
        "live",
        "nature"
      ],
      "clock": {
        "style": 3,
        "x": 108,
        "y": 58,
        "color": "#fff4e0"
      },
      "settings": [
        {
          "key": "lat",
          "label": "Latitude",
          "type": "number",
          "default": 51.5,
          "help": "Positive is north"
        },
        {
          "key": "lon",
          "label": "Longitude",
          "type": "number",
          "default": -0.13,
          "help": "Positive is east"
        },
        {
          "key": "h12",
          "label": "12-hour labels",
          "type": "boolean",
          "default": false
        }
      ],
      "live": "Sunrise and sunset for the day you install it",
      "entry": "daylight.js"
    },
